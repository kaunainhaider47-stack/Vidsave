PORT=3000
# Comma-separated exact hostnames for direct media files you own or are authorized to retrieve.
# Pinterest page URLs are validated but are intentionally not scraped or bypassed.
DOWNLOAD_ALLOWED_HOSTS=media.example.com
MAX_DOWNLOAD_BYTES=524288000
DOWNLOAD_TIMEOUT_MS=30000
ALLOWED_CONTENT_TYPES=video/*,application/octet-stream
# Exact frontend origin(s), comma-separated, when frontend and API are deployed separately.
CORS_ORIGIN=
