PORT=3000
# Exact comma-separated hostnames for direct media files you own or are authorized to retrieve.
# Do not add pinterest.com or private/internal services.
DOWNLOAD_ALLOWED_HOSTS=media.example.com
MAX_DOWNLOAD_BYTES=524288000
DOWNLOAD_TIMEOUT_MS=30000
ALLOWED_CONTENT_TYPES=video/*,application/octet-stream
# Exact frontend origins, comma-separated, when frontend and API are deployed separately.
# Example: https://kaunainhaider47-stack.github.io
CORS_ORIGIN=
